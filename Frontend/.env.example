# Variables de entorno del Frontend (Vite).
# Copiar como Frontend/.env.local para desarrollo local.
# Las variables VITE_* quedan expuestas en el bundle — no colocar secretos aquí.

# URL base de la API backend (sin trailing slash).
# En desarrollo el proxy de Vite reescribe /api, por lo que suele quedar vacío.
VITE_API_URL=

# Versión de la aplicación (inyectada en los reportes de Sentry).
VITE_APP_VERSION=

# DSN de Sentry para monitoreo de errores de producción.
# Dejar vacío para deshabilitar (no se envía nada a Sentry cuando está vacío).
# Solo se activa en modo production (PROD=true). En desarrollo/staging no se envía nada.
VITE_SENTRY_DSN=
