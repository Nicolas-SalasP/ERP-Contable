<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Archivos físicos pasan directo (JS, CSS, imágenes, favicon, etc.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 2. Rutas Laravel → index.php (API REST + Sanctum + rutas internas)
    RewriteRule ^api/ index.php [L]
    RewriteRule ^sanctum/ index.php [L]
    RewriteRule ^internal/ index.php [L]

    # 3. Todo lo demás → React Router (index.html)
    RewriteRule ^ index.html [L]
</IfModule>

Options -Indexes
