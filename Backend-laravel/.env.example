APP_NAME=Laravel
# Defaults SEGUROS para produccion. En DESARROLLO LOCAL cambiar a:
#   APP_ENV=local  y  APP_DEBUG=true
# (APP_DEBUG=true en produccion expone stack traces con variables de entorno sensibles).
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://erp.tenri.cl,https://tenri.cl

# Version mostrada en la doc OpenAPI (/docs/api). Debe coincidir con el tag de release en Git.
API_VERSION=1.11.0

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_CL

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookie de sesion solo por HTTPS. Default: true en produccion (app()->environment('production')),
# false en el resto de entornos. Solo se necesita fijarla explicitamente para forzar
# un valor distinto al default por entorno.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# database: los Jobs del SII corren asincronos. Requiere un worker: php artisan queue:work
QUEUE_CONNECTION=database

# database (no file): con multiples workers PHP el cache 'file' es por proceso
# y rompe los locks (p.ej. Cache::add de asientos) permitiendo duplicados.
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# INTEGRACIÓN CON TENRI-WEB (api.tenri.cl)
ERP_INTEGRATION_KEY=
WEB_INTEGRATION_KEY=
TENRI_WEB_BASE_URL=https://api.tenri.cl
# S-6: el canal interno autentica con firma HMAC. Deja este flag en false (default)
# para rechazar la llave estática legacy X-WEB-API-KEY. Actívalo solo, de forma
# temporal y coordinada, si la web aún no firma con HMAC.
WEB_INTEGRATION_ALLOW_LEGACY_KEY=false

# SEED DEMO. Password para los usuarios de demostracion (UserSeeder). Si queda
# vacio, el seeder genera uno aleatorio y lo imprime por consola. NUNCA usar un
# valor por defecto conocido (p. ej. 'password123') en entornos accesibles.
DEMO_SEED_PASSWORD=

# MONITOREO (Sentry). DSN vacio = no-op (dev/tests). En PRODUCCION setear el DSN.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_SEND_DEFAULT_PII=false

# BACKUPS (spatie/laravel-backup). El backup incluye el dump completo de la BD
# y storage/app/sii (certificados digitales SII) -- SIEMPRE debe ir cifrado.
# BACKUP_ARCHIVE_PASSWORD vacio = backup SIN CIFRAR. Generar con:
#   php -r "echo bin2hex(random_bytes(32));"
# y guardarla en un gestor de secretos, NUNCA en el repositorio.
BACKUP_ARCHIVE_PASSWORD=
BACKUP_DESTINATION_DISK=local
BACKUP_NOTIFICATION_EMAIL=no-reply@tenri.cl
# Solo si mysqldump NO esta en el PATH (p. ej. XAMPP: C:/xampp/mysql/bin). Vacio en prod Linux.
DB_DUMP_BINARY_PATH=

# CIFRADO DE PII CON CIPHERSWEET (spatie/laravel-ciphersweet + paragonie/ciphersweet)
# -----------------------------------------------------------------------
# Genera una clave con: php artisan ciphersweet:generate-key --show
# Salida: 64 caracteres hexadecimales (32 bytes de entropía).
#
# ADVERTENCIAS DE PRODUCCION:
#   - Esta clave debe ser DISTINTA de APP_KEY (propósitos separados).
#   - Guarda la clave en un gestor de secretos (AWS Secrets Manager, Vault, etc.).
#   - Perder esta clave hace IRRECUPERABLE toda la PII cifrada (email, telefono, direccion).
#   - Rotar la clave requiere el comando: php artisan ciphersweet:encrypt "<Model>" <nuevaClave>
#   - NUNCA comitees la clave de produccion en el repositorio.
CIPHERSWEET_KEY=

# AUDITORIA PII (Ley 21.719 — Fase 3)
# -----------------------------------------------------------------------
# Cuando esta en true, cada consulta al detalle de una liquidacion genera
# una fila en la tabla auditorias con operacion='LECTURA'. Mantener en true
# en produccion. Se puede poner en false en entornos de test de carga o CI
# para reducir I/O, pero NUNCA en produccion.
AUDITORIA_LECTURA_PII=true

# DERECHOS ARCO+ (Ley 21.719 — Fase 5)
# -----------------------------------------------------------------------
# Plazo de retención legal en años (Código del Trabajo / normas tributarias).
# Mientras un titular tenga registros dentro de esta ventana, el derecho de
# supresión se ejecuta de forma PARCIAL (bloqueo + scrub de contacto).
# Pasado el plazo, procede la anonimización TOTAL.
ARCO_RETENCION_ANIOS=6

# ALMACENAMIENTO XML DTE (retención legal 6 años — Res. SII N°80/2022)
SII_DISK=sii_xml
SII_XML_DISK=sii_xml
SII_XML_DISK_DRIVER=local
